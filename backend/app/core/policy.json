{
  "rules": [
    {
      "id": 1,
      "name": "Bulk Record Delete Protection",
      "action": "delete_records",
      "condition": {
        "record_count_gt": 100
      },
      "decision": "block",
      "reason": "Bulk record delete exceeds 100 limit policy."
    },
    {
      "id": 2,
      "name": "External Email HITL Signoff",
      "action": "send_email",
      "condition": {
        "external": true
      },
      "decision": "require_hitl",
      "reason": "External emails require human-in-the-loop review."
    },
    {
      "id": 3,
      "name": "Confidential File Access Log & Allow",
      "action": "read_file",
      "condition": {
        "classification": "confidential"
      },
      "decision": "log_and_allow",
      "reason": "Read of confidential path logged and allowed."
    }
  ]
}